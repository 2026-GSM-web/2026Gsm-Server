# .env를 만들 때 이 파일을 복사해서 채운다: cp .env.example .env
# 실제 값이 들어가는 .env는 커밋하지 말 것 (.gitignore에 이미 등록됨).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=schoolweb
DB_USERNAME=
DB_PASSWORD=

# 32바이트 이상의 임의 문자열 (예: openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# POST /api/auth/promote 로 보내면 관리자로 승격되는 공유 비밀값
ADMIN_MASTER_CODE=

FRONTEND_ORIGIN=http://service.gsmsv.site:30812
FRONTEND_OAUTH2_REDIRECT_URI=http://service.gsmsv.site:30812/callback
FRONTEND_OAUTH2_ERROR_REDIRECT_URI=http://service.gsmsv.site:30812/callback?error=true

# DataGSM(https://docs.datagsm.kr). CLIENT_ID/SECRET은 datagsm.kr/clients 에서
# 클라이언트 생성 후 채운다 (redirect_uri: http://localhost:8080/login/oauth2/code/school)
SCHOOL_OAUTH_CLIENT_ID=
SCHOOL_OAUTH_CLIENT_SECRET=
SCHOOL_OAUTH_AUTH_URI=https://oauth.authorization.datagsm.kr/v1/oauth/authorize
SCHOOL_OAUTH_TOKEN_URI=https://oauth.authorization.datagsm.kr/v1/oauth/token
SCHOOL_OAUTH_USERINFO_URI=https://oauth.resource.datagsm.kr/userinfo
SCHOOL_OAUTH_SCOPES=datagsm:self_read
SCHOOL_OAUTH_USERNAME_ATTRIBUTE=id
SCHOOL_OAUTH_ID_ATTR=id
SCHOOL_OAUTH_NAME_ATTR=student.name
SCHOOL_OAUTH_EMAIL_ATTR=email

# 학생 데이터 OpenAPI 조회용 API 키 (로그인과는 별개, datagsm.kr에서 발급)
DATAGSM_API_KEY=

SERVER_PORT=8081
