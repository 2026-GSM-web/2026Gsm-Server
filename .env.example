# .env를 만들 때 이 파일을 복사해서 채운다: cp .env.example .env
# 실제 값이 들어가는 .env는 커밋하지 말 것 (.gitignore에 이미 등록됨).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=schoolweb
DB_USERNAME=
DB_PASSWORD=

# 32바이트 이상의 임의 문자열 (예: openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# POST /api/auth/promote 로 보내면 관리자로 승격되는 공유 비밀값
ADMIN_MASTER_CODE=

FRONTEND_ORIGIN=http://service.gsmsv.site:30812

# DataGSM(https://docs.datagsm.kr). CLIENT_ID/SECRET은 datagsm.kr/clients 에서 클라이언트
# 생성 후 채운다. 백엔드가 GET /api/auth/dg/authorize -> /callback 리다이렉트 체인을 직접
# 소유하므로(프론트는 이 URL로 이동만 시킴), redirect_uri는 백엔드 자신의 콜백 주소를 DG
# 클라이언트 콘솔에 등록해야 한다. code->token->userinfo 교환은 datagsm-oauth-sdk-java
# (공식 SDK)가 처리한다 (AuthService 참고).
SCHOOL_OAUTH_CLIENT_ID=
SCHOOL_OAUTH_CLIENT_SECRET=

# 백엔드 자신의 콜백 URL (DG 클라이언트 콘솔에 redirect_uri로 등록된 값과 정확히 일치해야 함).
SCHOOL_OAUTH_REDIRECT_URI=http://localhost:8081/api/auth/dg/callback

# 로그인 완료 후 프론트로 리다이렉트할 최종 URL. 아직 확정된 값이 없으므로 절대 임의로
# 채우지 말 것 - 비어 있으면 콜백이 500으로 명확히 실패한다 (Open Redirect 방지 목적으로
# 이 값 하나로만 리다이렉트 대상이 결정됨).
APP_WEB_OAUTH_CALLBACK_REDIRECT_URL=

# OAuth state를 Redis에 저장해두는 TTL(초). 기본 300초.
OAUTH_STATE_TTL_SECONDS=300

# 로그인 성공 시 심는 JWT 쿠키의 Secure 속성. 운영은 https라 true, 순수 http로 붙는
# 로컬 환경이면 false로 오버라이드(Secure 쿠키는 https에서만 브라우저가 전송함).
OAUTH_COOKIE_SECURE=true

# OAuth state를 짧은 TTL로 저장하는 Redis 연결 정보.
REDIS_HOST=localhost
REDIS_PORT=6379

# 학생 데이터 OpenAPI 조회용 API 키 (로그인과는 별개, datagsm.kr에서 발급)
DATAGSM_API_KEY=

SERVER_PORT=8081
