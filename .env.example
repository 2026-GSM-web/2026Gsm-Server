# .env를 만들 때 이 파일을 복사해서 채운다: cp .env.example .env
# 실제 값이 들어가는 .env는 커밋하지 말 것 (.gitignore에 이미 등록됨).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=schoolweb
DB_USERNAME=
DB_PASSWORD=

# 32바이트 이상의 임의 문자열 (예: openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# POST /api/auth/promote 로 보내면 관리자로 승격되는 공유 비밀값
ADMIN_MASTER_CODE=

# CORS 허용 origin. 콤마로 여러 개 나열 가능 (예: 운영+스테이징을 동시에 허용해야 할 때).
# CORS는 브라우저 Origin 헤더와 완전 문자열 일치가 필요하므로(스킴/호스트/포트까지) 실제 프론트
# 접속 주소와 정확히 같아야 한다. 운영 프론트 도메인은 https://service.https.gsmsv.site 로
# 확인됨(2026-09-01) - 이전 값(service.gsmsv.site:30812)에서 도메인이 바뀌었으니 실서버 .env도
# 이 값으로 맞춰져 있는지 확인할 것.
FRONTEND_ORIGIN=https://service.https.gsmsv.site

# DataGSM(https://docs.datagsm.kr). CLIENT_ID/SECRET은 datagsm.kr/clients 에서 클라이언트
# 생성 후 채운다. 백엔드가 GET /api/auth/dg/authorize -> /callback 리다이렉트 체인을 직접
# 소유하므로(프론트는 이 URL로 이동만 시킴), redirect_uri는 백엔드 자신의 콜백 주소를 DG
# 클라이언트 콘솔에 등록해야 한다. code->token->userinfo 교환은 datagsm-oauth-sdk-java
# (공식 SDK)가 처리한다 (AuthService 참고).
SCHOOL_OAUTH_CLIENT_ID=
SCHOOL_OAUTH_CLIENT_SECRET=

# 백엔드 자신의 콜백 URL (DG 클라이언트 콘솔에 redirect_uri로 등록된 값과 정확히 일치해야 함).
# 운영 배포 도메인은 https://school.https.gsmsv.site 로 확인됨(2026-08-24, 민욱) -> 운영에서는
# SCHOOL_OAUTH_REDIRECT_URI=https://school.https.gsmsv.site/api/auth/dg/callback 로 설정하고,
# DG 클라이언트 콘솔(datagsm.kr/clients)에도 redirect_uri를 이 값과 정확히 동일하게 등록할 것.
SCHOOL_OAUTH_REDIRECT_URI=http://localhost:8081/api/auth/dg/callback

# 로그인 완료 후 프론트로 리다이렉트할 최종 URL. 마지막으로 확정된 값은 2026-08-24(민욱) 기준
# https://2026-gsm-client.vercel.app/callback (vercel.app) 이지만, 프론트 운영 도메인이 이후
# https://service.https.gsmsv.site 로 옮겨간 것으로 보여(2026-09-01) 이 값도 함께 바뀌었을 가능성이
# 높다 - 실서버에 반영하기 전에 반드시 프론트 팀에게 현재 콜백 페이지 주소(예: 프론트 저장소
# app/callback/page.tsx가 서비스되는 실제 URL)를 재확인할 것. 비어 있으면 콜백이 500으로 명확히
# 실패한다 (Open Redirect 방지 목적으로 이 값 하나로만 리다이렉트 대상이 결정됨).
APP_WEB_OAUTH_CALLBACK_REDIRECT_URL=https://2026-gsm-client.vercel.app/callback

# OAuth state를 Redis에 저장해두는 TTL(초). 기본 300초.
OAUTH_STATE_TTL_SECONDS=300

# 로그인 성공 시 심는 JWT 쿠키의 Secure 속성. 운영은 https라 true, 순수 http로 붙는
# 로컬 환경이면 false로 오버라이드(Secure 쿠키는 https에서만 브라우저가 전송함).
OAUTH_COOKIE_SECURE=true

# OAuth state를 짧은 TTL로 저장하는 Redis 연결 정보.
REDIS_HOST=localhost
REDIS_PORT=6379

# 학생 데이터 OpenAPI 조회용 API 키 (로그인과는 별개, datagsm.kr에서 발급)
DATAGSM_API_KEY=

SERVER_PORT=8081
